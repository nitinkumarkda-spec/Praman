# =====================================================================
# PRAMAAN — environment settings (template)
# Copy this file to ".env" and fill in the values for the server.
# .env holds secrets: never commit it, never put it in a public folder.
# (The root .htaccess already blocks every dot-file and *.env over HTTP.)
# Format: KEY=value · "double quotes" for spaces / # · lines starting with # are comments.
# Branding, landing texts and security / verification limits are edited by
# the Super Admin in App Settings — not here.
# =====================================================================

# ---------- Application ----------
APP_NAME=PRAMAAN
# local = your PC / test server · production = live server
APP_ENV=production
# true shows error details on screen — NEVER true on a live server
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
# web folder of the app, e.g. /pramaan_kda/pramaan_develop — leave empty to auto-detect
APP_BASE_PATH=
# true on the live server (HTTPS); also uncomment the HTTPS / HSTS lines in both .htaccess files
APP_FORCE_HTTPS=true

# ---------- Database (MySQL / MariaDB) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pramaan_db
# live server: a least-privilege user (see the end of database/schema.sql), not root
DB_USERNAME=pramaan_app
DB_PASSWORD="change-this-to-a-long-random-password"

# ---------- Session ----------
SESSION_NAME=PRAMAAN_SID
# logged out after this many idle minutes (App Settings can change it)
SESSION_IDLE_MINUTES=30
# maximum session life, even when active
SESSION_LIFETIME_MINUTES=480

# ---------- Security ----------
# failed logins are counted over this window (minutes)
LOGIN_WINDOW_MINUTES=15

# ---------- Data sent to the browser per sign-in ----------
STATE_AUDIT_LIMIT=3000
STATE_NOTIFICATION_LIMIT=300
