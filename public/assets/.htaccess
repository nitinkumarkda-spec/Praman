# =====================================================================
# PRAMAN — assets: static files only, NO script execution
# =====================================================================
Options -Indexes -ExecCGI
<FilesMatch "\.(php|php\d|phtml|phar|pht|phps|pl|py|cgi|sh|asp|aspx|jsp|exe|bat|cmd)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule php_module>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi
RemoveType .php .phtml .phar
